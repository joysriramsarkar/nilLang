// Nilang Standard Library
// Module: std/collections
//
// ফাংশনাল অ্যারে-সহায়ক — map/filter/reduce/find/zip/flatten।
//
// উদাহরণ:
//
//   import "std/collections" as c;
//   c.map([1, 2, 3], fn(x) { return x * 2; }); // [2, 4, 6]

let empty = fn() {
    return [];
};

let singleton = fn(value) {
    return [value];
};

let contains = fn(values, target) {
    let i = 0;

    while (i < len(values)) {
        if (values[i] == target) {
            return true;
        }

        i = i + 1;
    }

    return false;
};

let indexOf = fn(values, target) {
    let i = 0;

    while (i < len(values)) {
        if (values[i] == target) {
            return i;
        }

        i = i + 1;
    }

    return -1;
};

let reverse = fn(values) {
    let result = [];
    let i = len(values) - 1;

    while (i >= 0) {
        result = push(result, values[i]);
        i = i - 1;
    }

    return result;
};

let map = fn(values, mapper) {
    let result = [];
    let i = 0;

    while (i < len(values)) {
        result = push(result, mapper(values[i]));
        i = i + 1;
    }

    return result;
};

let filter = fn(values, predicate) {
    let result = [];
    let i = 0;

    while (i < len(values)) {
        if (predicate(values[i])) {
            result = push(result, values[i]);
        }

        i = i + 1;
    }

    return result;
};

let find = fn(values, predicate) {
    let i = 0;

    while (i < len(values)) {
        if (predicate(values[i])) {
            return values[i];
        }

        i = i + 1;
    }

    return null;
};

let any = fn(values, predicate) {
    let i = 0;

    while (i < len(values)) {
        if (predicate(values[i])) {
            return true;
        }

        i = i + 1;
    }

    return false;
};

let all = fn(values, predicate) {
    let i = 0;

    while (i < len(values)) {
        if (!predicate(values[i])) {
            return false;
        }

        i = i + 1;
    }

    return true;
};

let count = fn(values, predicate) {
    let total = 0;
    let i = 0;

    while (i < len(values)) {
        if (predicate(values[i])) {
            total = total + 1;
        }

        i = i + 1;
    }

    return total;
};

let reduce = fn(values, initial, reducer) {
    let result = initial;
    let i = 0;

    while (i < len(values)) {
        result = reducer(result, values[i]);
        i = i + 1;
    }

    return result;
};

let sum = fn(values) {
    let result = 0;
    let i = 0;

    while (i < len(values)) {
        result = result + values[i];
        i = i + 1;
    }

    return result;
};

let product = fn(values) {
    let result = 1;
    let i = 0;

    while (i < len(values)) {
        result = result * values[i];
        i = i + 1;
    }

    return result;
};

let take = fn(values, countValue) {
    let result = [];
    let limit = countValue;

    if (limit < 0) {
        limit = 0;
    }

    if (limit > len(values)) {
        limit = len(values);
    }

    let i = 0;

    while (i < limit) {
        result = push(result, values[i]);
        i = i + 1;
    }

    return result;
};

let drop = fn(values, countValue) {
    let result = [];
    let start = countValue;

    if (start < 0) {
        start = 0;
    }

    if (start > len(values)) {
        start = len(values);
    }

    let i = start;

    while (i < len(values)) {
        result = push(result, values[i]);
        i = i + 1;
    }

    return result;
};

let range = fn(start, end) {
    let result = [];
    let i = start;

    while (i < end) {
        result = push(result, i);
        i = i + 1;
    }

    return result;
};

let enumerate = fn(values) {
    let result = [];
    let i = 0;

    while (i < len(values)) {
        result = push(
            result,
            {
                "index": i,
                "value": values[i]
            }
        );

        i = i + 1;
    }

    return result;
};

// flatMap — প্রতিটিতে mapper চালিয়ে ফলাফল-অ্যারে সমতল করে।
let flatMap = fn(values, mapper) {
    let result = [];
    let i = 0;
    while (i < len(values)) {
        let mapped = mapper(values[i]);
        let j = 0;
        while (j < len(mapped)) {
            result = push(result, mapped[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
};

// flatten — এক-স্তর নেস্টেড অ্যারে সমতল করে।
let flatten = fn(nested) {
    return flatMap(nested, fn(x) { return x; });
};

// zip — দুটি অ্যারেকে [a, b] জোড়ার অ্যারে বানায় (ছোটটির দৈর্ঘ্যে)।
let zip = fn(a, b) {
    let result = [];
    let n = len(a);
    if (len(b) < n) {
        n = len(b);
    }
    let i = 0;
    while (i < n) {
        result = push(result, [a[i], b[i]]);
        i = i + 1;
    }
    return result;
};

// unique — প্রথম-আবির্ভাব ক্রমে স্বতন্ত্র মান।
let unique = fn(values) {
    let result = [];
    let i = 0;
    while (i < len(values)) {
        if (indexOf(result, values[i]) == -1) {
            result = push(result, values[i]);
        }
        i = i + 1;
    }
    return result;
};

// partition — predicate অনুযায়ী [মিল, অমিল] দুই অ্যারে।
let partition = fn(values, predicate) {
    let yes = [];
    let no = [];
    let i = 0;
    while (i < len(values)) {
        if (predicate(values[i])) {
            yes = push(yes, values[i]);
        } else {
            no = push(no, values[i]);
        }
        i = i + 1;
    }
    return [yes, no];
};
