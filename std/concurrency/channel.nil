let create = fn(capacity) {
    return Channel(capacity);
};
let sendValue = fn(channel, value) {
    return send(channel, value);
};
let receiveValue = fn(channel) {
    return receive(channel);
};
let sendAll = fn(channel, values) {
    let i = 0;
    while (i < len(values)) {
        send(channel, values[i]);
        i = i + 1;
    }
    return len(values);
};
let receiveAll = fn(channel, count) {
    let out = [];
    let i = 0;
    while (i < count) {
        out = push(out, receive(channel));
        i = i + 1;
    }
    return out;
};
let pipeline = fn(source, count, transform) {
    let out = Channel(count);
    let done = task { let i = 0;while ((i < count)) { let v = receive(source);send(out, transform(v))i = (i + 1); }return count; };
    return {"output": out, "done": done};
};
let selectRecv = fn(channels) {
    if (len(channels) == 1) {
        return {"index": 0, "value": receive(channels[0])};
    }
    if (len(channels) == 2) {
        return native("std.sync.select_recv", channels[0], channels[1]);
    }
    if (len(channels) == 3) {
        return native("std.sync.select_recv", channels[0], channels[1], channels[2]);
    }
    return Err("selectRecv supports 1..3 channels");
};
