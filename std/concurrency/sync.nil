let newMutex = fn() {
    let gate = Channel(1);
    send(gate, "unlocked");
    return {"gate": gate};
};
let lock = fn(m) {
    return receive(m["gate"]);
};
let unlock = fn(m) {
    return send(m["gate"], "unlocked");
};
let tryLock = fn(m) {
    return lock(m);
};
let withLock = fn(m, critical) {
    lock(m);
    let result = critical();
    unlock(m);
    return result;
};
let newOnce = fn() {
    return {"fired": false, "value": null};
};
let doOnce = fn(guard, body) {
    if (guard["fired"]) {
        return {"value": guard["value"], "guard": guard};
    }
    let v = body();
    let next = {"fired": true, "value": v};
    return {"value": v, "guard": next};
};
