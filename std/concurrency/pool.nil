let runWorker = fn(jobs, items, worker) {
    let acc = [];
    let live = true;
    while (live) {
        let j = receive(jobs);
        if (j == -1) {
            live = false;
        } else {
            acc = push(acc, [j, worker(items[j])]);
        }
    }
    return acc;
};
let startWorker = fn(jobs, items, worker) {
    return task { return runWorker(jobs, items, worker); };
};
let map = fn(items, worker, size) {
    let n = len(items);
    if (n == 0) {
        return [];
    }
    let width = size;
    if (width == null || width < 1) {
        width = 1;
    }
    let jobs = Channel(n + width);
    let i = 0;
    while (i < n) {
        send(jobs, i);
        i = i + 1;
    }
    let s = 0;
    while (s < width) {
        send(jobs, -1);
        s = s + 1;
    }
    let workers = [];
    let w = 0;
    while (w < width) {
        workers = push(workers, startWorker(jobs, items, worker));
        w = w + 1;
    }
    let pairs = [];
    let k = 0;
    while (k < len(workers)) {
        let f = workers[k];
        let acc = await f;
        let m = 0;
        while (m < len(acc)) {
            pairs = push(pairs, acc[m]);
            m = m + 1;
        }
        k = k + 1;
    }
    let ordered = [];
    let t = 0;
    while (t < n) {
        let found = null;
        let p = 0;
        while (p < len(pairs)) {
            if (pairs[p][0] == t) {
                found = pairs[p][1];
            }
            p = p + 1;
        }
        ordered = push(ordered, found);
        t = t + 1;
    }
    return ordered;
};
let runEach = fn(items, action, size) {
    let sink = map(items, action, size);
    return len(sink);
};
