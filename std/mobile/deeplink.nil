import "std/net/url" as url;
let parse = fn(link) {
    let q = url.query(link);
    return {"scheme": url.scheme(link), "host": url.host(link), "path": url.path(link), "query": q, "params": q};
};
let route = fn(link) {
    let p = url.path(link);
    let segs = split(p, "/");
    let clean = [];
    let i = 0;
    while (i < len(segs)) {
        if (segs[i] != "") {
            clean = push(clean, segs[i]);
        }
        i = i + 1;
    }
    if (len(clean) == 0) {
        return "home";
    }
    return first(clean);
};
let routeArg = fn(link) {
    let p = url.path(link);
    let segs = split(p, "/");
    let clean = [];
    let i = 0;
    while (i < len(segs)) {
        if (segs[i] != "") {
            clean = push(clean, segs[i]);
        }
        i = i + 1;
    }
    if (len(clean) < 2) {
        return null;
    }
    return clean[1];
};
