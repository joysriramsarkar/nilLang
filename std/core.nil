let identity = fn(value) {
    return value;
};
let isNull = fn(value) {
    return value == null;
};
let defaultValue = fn(value, fallback) {
    if (value == null) {
        return fallback;
    }
    return value;
};
let clamp = fn(value, low, high) {
    if (value < low) {
        return low;
    }
    if (value > high) {
        return high;
    }
    return value;
};
let repeat = fn(value, count) {
    let result = [];
    let i = 0;
    while (i < count) {
        result = push(result, value);
        i = i + 1;
    }
    return result;
};
let swap = fn(a, b) {
    return [b, a];
};
let ok = fn(val) {
    return Ok(val);
};
let err = fn(val) {
    return Err(val);
};
let some = fn(val) {
    return Some(val);
};
let none = fn() {
    return None();
};
let error = fn(code, message) {
    return {"code": code, "message": message};
};
let mapResult = fn(result, f) {
    if (isOk(result)) {
        return Ok(f(unwrap(result)));
    }
    return result;
};
let mapResultErr = fn(result, f) {
    if (isErr(result)) {
        return Err(f(errValue(result)));
    }
    return result;
};
let andThen = fn(result, f) {
    if (isOk(result)) {
        return f(unwrap(result));
    }
    return result;
};
let okOr = fn(opt, errVal) {
    if (isSome(opt)) {
        return Ok(unwrap(opt));
    }
    return Err(errVal);
};
let mapOption = fn(opt, f) {
    if (isSome(opt)) {
        return Some(f(unwrap(opt)));
    }
    return opt;
};
let unwrapOrDefault = fn(opt, fallback) {
    return unwrapOr(opt, fallback);
};
let expectOption = fn(opt, message) {
    assert(isSome(opt), message);
    return unwrap(opt);
};
let expectResult = fn(result, message) {
    assert(isOk(result), message);
    return unwrap(result);
};
let isEmptyValue = fn(value) {
    if (value == null) {
        return true;
    }
    if (type(value) == "STRING") {
        return len(value) == 0;
    }
    if (type(value) == "ARRAY") {
        return len(value) == 0;
    }
    return false;
};
let pipeline = fn(value, stages) {
    let current = value;
    let i = 0;
    while (i < len(stages)) {
        current = stages[i](current);
        i = i + 1;
    }
    return current;
};
