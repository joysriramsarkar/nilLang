import "std/crypto/hash" as hash;
import "std/crypto/hmac" as hmac;
import "std/crypto/random" as random;
import "std/crypto/aes" as aes;
import "std/crypto/ed25519" as ed25519;
import "std/data/base64" as base64;
let sha256 = hash.sha256;
let sha512 = hash.sha512;
let hmacSha256 = hmac.sha256;
let hmacVerify = hmac.verify;
let randomBytes = random.bytes;
let randomHex = random.hex;
let randomKey32 = random.key32;
let randomNonce12 = random.nonce12;
let aesEncrypt = aes.encrypt;
let aesDecrypt = aes.decrypt;
let edKeypair = ed25519.keypair;
let edSign = ed25519.sign;
let edVerify = ed25519.verify;
let base64Encode = base64.encode;
let base64Decode = base64.decode;
