let sysTime = time;
let nowUnix = fn() {
    return sysTime();
};
let isBefore = fn(a, b) {
    return a < b;
};
let isAfter = fn(a, b) {
    return a > b;
};
let equals = fn(a, b) {
    return a == b;
};
let addSeconds = fn(t, s) {
    return t + s;
};
let elapsedSince = fn(t) {
    return sysTime() - t;
};
let isExpired = fn(deadline) {
    return sysTime() >= deadline;
};
let deadlineIn = fn(secs) {
    return sysTime() + secs;
};
