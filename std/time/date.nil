import "std/time/instant" as instant;
let unixNow = fn() {
    return instant.nowUnix();
};
let addSeconds = fn(timestamp, seconds) {
    return timestamp + seconds;
};
let difference = fn(a, b) {
    return a - b;
};
let addDays = fn(timestamp, days) {
    return timestamp + days * 86400;
};
let addHours = fn(timestamp, hours) {
    return timestamp + hours * 3600;
};
let isSameDay = fn(a, b) {
    return a / 86400 == b / 86400;
};
let format = fn(millis, pattern) {
    return native("std.time.format", millis, pattern);
};
let formatSeconds = fn(secs, pattern) {
    return format(secs * 1000, pattern);
};
let today = fn() {
    return formatSeconds(instant.nowUnix(), "YYYY-MM-DD");
};
let yearOf = fn(secs) {
    return formatSeconds(secs, "YYYY");
};
let isoNow = fn() {
    return native("std.time.now_iso");
};
