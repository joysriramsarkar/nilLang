component Counter {
    state count: i32 = 0;

    render {
        return {
            "type": "Page",
            "title": "Alap UI Counter",
            "content": [
                {
                    "type": "Card",
                    "title": "Current Count",
                    "body": "\(count)"
                },
                {
                    "type": "Button",
                    "id": "increment-count",
                    "label": "Increment",
                    "event": "increment",
                    "payload": {"step": 1}
                }
            ],
            "footer": "NilLang declarative component"
        };
    }

    on increment(payload) {
        // `step` carries the same width as `count`.
        //
        // Reading it out of a payload gives the checker nothing, and adding an
        // untyped value to a declared `i32` is refused rather than assumed —
        // which is what "no implicit numeric coercion" means. The fallback keeps
        // the declaration's width because a literal takes the width of its
        // context.
        let step: i32 = 1;
        if (payload != null) {
            step = payload["step"] ?? 1;
        }
        count = count + step;
        emit("changed", count);
    }
}
