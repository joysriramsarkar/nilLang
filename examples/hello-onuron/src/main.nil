// Fibonacci sequence
let fibonacci = fn(n) {
    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
};

puts("📐 Fibonacci Sequence:");
let i = 0;
while (i < 10) {
    let val = fibonacci(i);
    puts("  fib(\(i)) = \(val)");
    let i = i + 1;
}

puts("");

// String operations
