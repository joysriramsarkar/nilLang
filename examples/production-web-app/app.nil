import "web";
import "data";
import "money";
import "security";
let product1 = {"id": "p-101", "name": "Alap Enterprise Core Server", "sku": "ALAP-ENT-001", "price": money.ofMinor(150000, "BDT"), "stock": 45};
let product2 = {"id": "p-102", "name": "Nilang High-Performance VM Node", "sku": "NIL-VM-002", "price": money.ofMinor(45000, "BDT"), "stock": 80};
let product3 = {"id": "p-103", "name": "SoftBus Real-time Mesh Router", "sku": "SB-MESH-003", "price": money.ofMinor(890000, "BDT"), "stock": 20};
let calculateTotal = fn(itemPrice, qty) {
    return money.mulQty(itemPrice, qty, 1);
};
component POSDashboard {
    state totalSales = "৳0.00";
    state ordersCount = 0;
}

let app = web.new("AlapProductionApp");
app.get("/api/v1/health", fn(req) {
    return {"status": "healthy", "engine": "Nilang VM", "framework": "Alap Web Enterprise"};
});
app.get("/api/v1/products", fn(req) {
    return [product1, product2, product3];
});
puts("✅ [Nilang] Enterprise Web Application configured successfully.");
