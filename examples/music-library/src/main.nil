import "../lib/Library.nil" as Library;
component MusicApp {
    state idx: i32 = 0;
    state playing: String = "";
    render {
        let lib = Library.createLibrary();
        let songs = Library.getAllSongs(lib);
        let rows = [];
        let i = 0;
        while (i < len(songs)) {
            rows = append(rows, {"type": "Card", "title": songs[i]["title"], "body": songs[i]["artist"]});
            i = i + 1;
        }
        return {"type": "Page", "title": "Music Library", "content": rows, "footer": "total: \(len(songs))"};
    }
    on play {
        idx = idx + 1;
        if (payload != null) {
            playing = payload["title"];
        }
        emit("played", playing);
    }
    on reset {
        idx = 0;
        playing = "";
        emit("reset", 0);
    }
}
