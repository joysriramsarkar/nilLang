import "./types.nil" as Types;
import "./account.nil" as Account;
import "./ledger.nil" as Ledger;
import "./interest.nil" as Interest;
import "./report.nil" as Report;
puts("╔══════════════════════════════════════════════════════════════════════════╗");
puts("║               🌟 NILBANK: CORE BANKING & LEDGER ENGINE v1.0              ║");
puts("║                 Powered by Nilang Language • Onuron OS Ecosystem         ║");
puts("╚══════════════════════════════════════════════════════════════════════════╝\n");
puts("🔹 ধাপ ১: গ্রাহক অ্যাকাউন্ট তৈরি ও কেওয়াইসি (KYC) যাচাইকরণ...");
let acc1 = Account.createAccount("ACC-1001", "জয়শ্রীরাম সরকার", Types.ACC_SAVINGS, 550000, Types.CURR_BDT);
let acc2 = Account.createAccount("ACC-1002", "এলিস জনসন", Types.ACC_CHECKING, 2500, Types.CURR_USD);
let acc3 = Account.createAccount("ACC-1003", "রহিম আহমেদ", Types.ACC_SAVINGS, 150000, Types.CURR_BDT);
let acc4 = Account.createAccount("ACC-1004", "করিম উদ্দিন", Types.ACC_SAVINGS, 30000, Types.CURR_BDT);
puts("  ✅ ৪টি গ্রাহক অ্যাকাউন্ট সফলভাবে নিবন্ধিত হয়েছে।\n");
puts("🔹 ধাপ ২: মাল্টি-কারেন্সি লেনদেন ও লেজার বুকিং পরিচালনা...");
puts("  [লেনদেন ১] এলিস জনসন $১,০০০ জমা করছেন...");
let dep1 = Ledger.deposit("ACC-1002", 1000, "বিদেশি রেমিট্যান্স প্রাপ্তি");
if (isOk(dep1)) {
    puts("  -> জমা সফল।");
}
puts("  [লেনদেন ২] রহিম আহমেদ ৳২০,০০০ এটিএম থেকে উত্তোলন করছেন...");
let wth1 = Ledger.withdraw("ACC-1003", 20000, "শপিংয়ের জন্য এটিএম ক্যাশ উত্তোলন");
if (isOk(wth1)) {
    puts("  -> উত্তোলন সফল।");
}
puts("  [লেনদেন ৩] এলিস জনসন করিমকে $৫০০ ডলার স্থানান্তর করছেন (স্বয়ংক্রিয় মুদ্রা রূপান্তর)...");
let trf1 = Ledger.transfer("ACC-1002", "ACC-1004", 500, "ফ্রিল্যান্স প্রজেক্টের পারিশ্রমিক");
if (isOk(trf1)) {
    puts("  -> আন্তর্জাতিক ফান্ড স্থানান্তর সফল ও ব্যালেন্স সমন্বয় সম্পন্ন।");
}
puts("  [লেনদেন ৪] জয়শ্রীরামের অ্যাকাউন্টে ৳২,০০,০০০ জমা (AML ফ্ল্যাগিং পরীক্ষা)...");
let dep2 = Ledger.deposit("ACC-1001", 200000, "জমি বিক্রয়ের অর্থ জমা");
if (isOk(dep2)) {
    let tx = unwrapOr(dep2, null);
    puts("  -> লেনদেন সম্পন্ন। স্ট্যাটাস: " + tx.status + " (স্বয়ংক্রিয় অডিট লগে ফ্ল্যাগড)");
}
puts("  [লেনদেন ৫] করিমের ১,০০,০০০ টাকা উত্তোলনের চেষ্টা (ব্যালেন্সের অতিরিক্ত)...");
let wth2 = Ledger.withdraw("ACC-1004", 100000, "উচ্চমাত্রার ঋণ পরিশোধ চেষ্টা");
if (isErr(wth2)) {
    puts("  -> প্রত্যাশিতভাবে ব্যর্থ হয়েছে: অপর্যাপ্ত তহবিল।");
}
puts("");
puts("🔹 ধাপ ৩: স্বয়ংক্রিয় ব্যাচ জব - সকল সক্রিয় অ্যাকাউন্টে মাসিক মুনাফা বিতরণ...");
let interestResult = Interest.applyMonthlyInterestToAll();
puts("  মুনাফা প্রাপ্ত অ্যাকাউন্ট সংখ্যা: " + str(interestResult.accountsProcessed) + " টি");
puts("  মোট বিতরিত মুনাফার পরিমাণ : ৳ " + str(interestResult.totalInterestDisbursed));
puts("  ✅ মাসিক মুনাফা বিতরণ চক্র সফলভাবে শেষ হয়েছে।\n");
puts("🔹 ধাপ ৪: ঋণ সিমুলেশন ও মাসিক কিস্তি বিশ্লেষণ...");
let loanEstimate = Interest.calculateSimpleLoanEstimate(500000, 9.0, 36);
puts("  ঋণের মূল পরিমাণ     : ৳ " + str(loanEstimate.principal));
puts("  ৩৬ মাসের মোট সুদ   : ৳ " + str(loanEstimate.totalInterest));
puts("  সর্বমোট পরিশোধযোগ্য  : ৳ " + str(loanEstimate.totalRepayment));
puts("  আনুমানিক মাসিক কিস্তি: ৳ " + str(loanEstimate.monthlyEmi) + "\n");
puts("🔹 ধাপ ৫: গ্রাহক অ্যাকাউন্ট স্টেটমেন্ট ও সেন্ট্রাল ব্যাংক অডিট ট্রেইল:\n");
Report.printAccountStatement("ACC-1001");
Report.printAccountStatement("ACC-1004");
Report.printBankHealthReport();
puts("🎉 NilBank কোর ব্যাংকিং সিস্টেম সফলভাবে সকল লেনদেন ও অডিট যাচাই সম্পন্ন করেছে!");
