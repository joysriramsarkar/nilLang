// ============================================================================
// NilDoc - Markdown AST Parser & Renderer Live Demonstration
// ============================================================================

import "./types.nil" as Types;
import "./parser.nil" as Parser;
import "./renderer.nil" as Renderer;

puts("╔══════════════════════════════════════════════════════════════════════════╗");
puts("║               📑 NILDOC: MARKDOWN AST PARSER & RENDERER 🌟              ║");
puts("║                    Powered by Nilang • Onuron OS Ecosystem               ║");
puts("╚══════════════════════════════════════════════════════════════════════════╝\n");

// নমুনা মার্কডাউন ডকুমেন্ট
let sampleMarkdown = "# নীলাং ইকোসিস্টেম ডকুমেন্টেশন
Onuron OS এবং Alap ফ্রেমওয়ার্কের জন্য নির্মিত একটি আধুনিক প্রোগ্রামিং ভাষা।

## মূল সুবিধাসমূহ
- ডাবল-এন্ট্রি ফাইন্যান্সিয়াল সিকিউরিটি
- টার্ন-বেসড গেম ইঞ্জিন আর্কিটেকচার
- স্বয়ংক্রিয় এএসটি পার্সার ও রেন্ডারার

> নীলাং দিয়ে সিস্টেম ও ডিক্লারেটিভ অ্যাপ্লিকেশন উভয়ই অনায়াসে তৈরি করা যায়।

---

## উদাহরণ কোড
```nil
let author = \"Joysriram Sarkar\";
puts(\"Hello, \" + author);
```

### উপসংহার
নীলাং প্রোগ্রামিং ভাষা ভবিষ্যৎ প্রযুক্তির এক অনন্য রূপ।";

puts("🔹 ধাপ ১: সোর্স মার্কডাউন বিশ্লেষণ ও টোকেনাইজেশন...");
let docAST = Parser.parseDocument(sampleMarkdown);

puts("  মোট তৈরি হওয়া AST নোড: " + str(len(docAST.children)) + " টি");
puts("  হেডিং সংখ্যা (Headings): " + str(Parser.countNodes(docAST, Types.NODE_HEADING)) + " টি");
puts("  কোড ব্লক সংখ্যা: " + str(Parser.countNodes(docAST, Types.NODE_CODE_BLOCK)) + " টি");
puts("  কোটেশন সংখ্যা: " + str(Parser.countNodes(docAST, Types.NODE_QUOTE)) + " টি\n");

puts("🔹 ধাপ ২: টার্মিনালে বিউটিফাইড ডকুমেন্ট রেন্ডারিং:\n");

Renderer.renderTerminal(docAST);

puts("\n🎉 NilDoc মার্কডাউন পার্সার ও রেন্ডারার সফলভাবে সম্পন্ন হয়েছে!");
