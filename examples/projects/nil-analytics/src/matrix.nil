// ============================================================================
// NilAnalytics - 2D Matrix Algebra Engine
// ============================================================================

import "./vector.nil" as Vector;

// Matrix dimensions
let dims = fn(mat) {
    let r = len(mat);
    let c = 0;
    if (r > 0) {
        c = len(mat[0]);
    }
    return { "rows": r, "cols": c };
};

// Matrix Transpose: M^T
let transpose = fn(mat) {
    let d = dims(mat);
    let trans = [];

    let c = 0;
    while (c < d.cols) {
        let newRow = [];
        let r = 0;
        while (r < d.rows) {
            newRow = push(newRow, mat[r][c]);
            r = r + 1;
        }
        trans = push(trans, newRow);
        c = c + 1;
    }

    return trans;
};

// Matrix Addition: A + B
let add = fn(matA, matB) {
    let dA = dims(matA);
    let res = [];

    let r = 0;
    while (r < dA.rows) {
        let rowA = matA[r];
        let rowB = matB[r];
        let sumRow = Vector.add(rowA, rowB);
        res = push(res, sumRow);
        r = r + 1;
    }

    return res;
};

// Matrix Multiplication: A * B
let matMul = fn(matA, matB) {
    let dA = dims(matA);
    let dB = dims(matB);

    if (dA.cols != dB.rows) {
        return null;
    }

    let bTrans = transpose(matB);
    let result = [];

    let r = 0;
    while (r < dA.rows) {
        let resultRow = [];
        let c = 0;
        while (c < dB.cols) {
            let dotProduct = Vector.dot(matA[r], bTrans[c]);
            resultRow = push(resultRow, dotProduct);
            c = c + 1;
        }
        result = push(result, resultRow);
        r = r + 1;
    }

    return result;
};

// Scalar Multiply: M * scalar
let scale = fn(mat, scalar) {
    let res = [];
    let r = 0;
    while (r < len(mat)) {
        res = push(res, Vector.scale(mat[r], scalar));
        r = r + 1;
    }
    return res;
};
