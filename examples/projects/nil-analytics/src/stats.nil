// ============================================================================
// NilAnalytics - Descriptive Statistics & Numerical Math
// ============================================================================

import "./vector.nil" as Vector;

// Square Root using Newton-Raphson method
let sqrt = fn(val) {
    if (val <= 0.0) {
        return 0.0;
    }
    let x = val;
    let i = 0;
    while (i < 25) {
        x = 0.5 * (x + (val / x));
        i = i + 1;
    }
    return x;
};

// Arithmetic Mean
let mean = fn(v) {
    let n = len(v);
    if (n == 0) {
        return 0.0;
    }
    return Vector.sum(v) / (n * 1.0);
};

// Minimum value
let minVal = fn(v) {
    if (len(v) == 0) { return 0.0; }
    let m = v[0];
    let i = 1;
    while (i < len(v)) {
        if (v[i] < m) {
            m = v[i];
        }
        i = i + 1;
    }
    return m;
};

// Maximum value
let maxVal = fn(v) {
    if (len(v) == 0) { return 0.0; }
    let m = v[0];
    let i = 1;
    while (i < len(v)) {
        if (v[i] > m) {
            m = v[i];
        }
        i = i + 1;
    }
    return m;
};

// Variance: sum((x - mean)^2) / N
let variance = fn(v) {
    let n = len(v);
    if (n <= 1) {
        return 0.0;
    }
    let m = mean(v);
    let sumSqDiff = 0.0;

    let i = 0;
    while (i < n) {
        let diff = v[i] - m;
        sumSqDiff = sumSqDiff + (diff * diff);
        i = i + 1;
    }

    return sumSqDiff / (n * 1.0);
};

// Standard Deviation
let stdDev = fn(v) {
    return sqrt(variance(v));
};

// Sort array in ascending order (Insertion Sort)
let sortAsc = fn(v) {
    let arr = [];
    let i = 0;
    while (i < len(v)) {
        arr = push(arr, v[i]);
        i = i + 1;
    }

    let a = 1;
    while (a < len(arr)) {
        let key = arr[a];
        let b = a - 1;
        while (b >= 0 && arr[b] > key) {
            arr[b + 1] = arr[b];
            b = b - 1;
        }
        arr[b + 1] = key;
        a = a + 1;
    }
    return arr;
};

// Median
let median = fn(v) {
    let n = len(v);
    if (n == 0) { return 0.0; }
    let sorted = sortAsc(v);
    let mid = n / 2;

    if (n % 2 != 0) {
        return sorted[mid] * 1.0;
    }
    return (sorted[mid - 1] + sorted[mid]) / 2.0;
};
