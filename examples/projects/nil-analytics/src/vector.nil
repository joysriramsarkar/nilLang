// ============================================================================
// NilAnalytics - Vector Algebra Operations
// ============================================================================

// Vector Dot Product: v1 . v2
let dot = fn(v1, v2) {
    let size = len(v1);
    if (size != len(v2)) {
        return 0.0;
    }
    let total = 0.0;
    let i = 0;
    while (i < size) {
        total = total + (v1[i] * v2[i]);
        i = i + 1;
    }
    return total;
};

// Vector Addition: v1 + v2
let add = fn(v1, v2) {
    let size = len(v1);
    let res = [];
    let i = 0;
    while (i < size) {
        res = push(res, v1[i] + v2[i]);
        i = i + 1;
    }
    return res;
};

// Vector Subtraction: v1 - v2
let sub = fn(v1, v2) {
    let size = len(v1);
    let res = [];
    let i = 0;
    while (i < size) {
        res = push(res, v1[i] - v2[i]);
        i = i + 1;
    }
    return res;
};

// Scalar Multiply: v * scalar
let scale = fn(v, scalar) {
    let res = [];
    let i = 0;
    while (i < len(v)) {
        res = push(res, v[i] * scalar);
        i = i + 1;
    }
    return res;
};

// Sum of elements
let sum = fn(v) {
    let total = 0.0;
    let i = 0;
    while (i < len(v)) {
        total = total + v[i];
        i = i + 1;
    }
    return total;
};

// Squared Norm (magnitude squared): sum of x^2
let normSq = fn(v) {
    return dot(v, v);
};
