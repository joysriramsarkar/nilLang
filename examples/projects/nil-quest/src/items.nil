// ============================================================================
// NilQuest - Item & Inventory System
// ============================================================================

import "./types.nil" as Types;

// Item Catalog Factories
let createWeapon = fn(name, attackBonus, element) {
    return {
        "name": name,
        "itemKind": Types.ITEM_WEAPON,
        "attackBonus": attackBonus,
        "element": element
    };
};

let createArmor = fn(name, defenseBonus) {
    return {
        "name": name,
        "itemKind": Types.ITEM_ARMOR,
        "defenseBonus": defenseBonus
    };
};

let createPotion = fn(name, healAmount, manaAmount) {
    return {
        "name": name,
        "itemKind": Types.ITEM_POTION,
        "healAmount": healAmount,
        "manaAmount": manaAmount
    };
};

// Equip an item to a hero
let equipItem = fn(hero, item) {
    if (item.itemKind == Types.ITEM_WEAPON) {
        hero["equippedWeapon"] = item;
        hero["attack"] = hero.baseAttack + item.attackBonus;
        return Ok("অস্ত্র সুসজ্জিত হয়েছে: " + item.name);
    }
    if (item.itemKind == Types.ITEM_ARMOR) {
        hero["equippedArmor"] = item;
        hero["defense"] = hero.baseDefense + item.defenseBonus;
        return Ok("বর্ম পরিহিত হয়েছে: " + item.name);
    }
    return Err("এই উপাদানটি পরিধানযোগ্য নয়");
};

// Use a potion from inventory
let usePotion = fn(hero, potion) {
    if (potion.itemKind != Types.ITEM_POTION) {
        return Err("এটি কোনো পানীয় (Potion) নয়");
    }

    let heal = potion.healAmount;
    let newHp = hero.hp + heal;
    if (newHp > hero.maxHp) {
        newHp = hero.maxHp;
    }
    hero["hp"] = newHp;

    let mana = potion.manaAmount;
    let newMp = hero.mp + mana;
    if (newMp > hero.maxMp) {
        newMp = hero.maxMp;
    }
    hero["mp"] = newMp;

    return Ok("পোশন ব্যবহার সফল: +" + str(heal) + " HP, +" + str(mana) + " MP");
};
