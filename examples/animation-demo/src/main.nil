// Animation Demo in Nilang
// Demonstrating 60 FPS easing curves on Onuron GPU

puts("🎬 Nilang Animation Engine - Onuron GPU Pipeline");

let frames = 5;
let i = 0;

let easeOutBounce = fn(t) {
    if (t < 0.3636) {
        return 7.5625 * t * t;
    }
    return 1.0;
};

puts("Simulating 60FPS timeline updates:");
while (i <= frames) {
    let t = (i * 1.0) / 5.0;
    let progress = easeOutBounce(t);
    puts("  Frame \(i): t = \(t), progress = \(progress)");
    let i = i + 1;
}

puts("✨ Animation completed with smooth 60fps rendering!");
