fn padStart(str, targetLen, padChar) {
    let currentLen = len(str);
    if (currentLen >= targetLen) {
        return str;
    }
    let padding = "";
    let i = 0;
    while (i < targetLen - currentLen) {
        padding = padding + padChar;
        i = i + 1;
    }
    return padding + str;
}

puts("রোল নম্বর: " + padStart("42", 5, "0"));
puts("রোল নম্বর: " + padStart("7", 5, "0"));
