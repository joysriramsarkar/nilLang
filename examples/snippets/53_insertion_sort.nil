fn insertionSort(arr) {
    let n = len(arr);
    let i = 1;
    while (i < n) {
        let key = arr[i];
        let j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
        i = i + 1;
    }
    return arr;
}

let data = [12, 11, 13, 5, 6];
puts("ইনসার্শন সর্ট: \(insertionSort(data))");
