fn filterArr(arr, predicate) {
    let res = [];
    for item in arr {
        if (predicate(item)) {
            res = push(res, item);
        }
    }
    return res;
}

let nums = [1, 2, 3, 4, 5, 6, 7, 8];
let evens = filterArr(nums, fn(x) {
    return x % 2 == 0;
});
puts("জোড় সংখ্যা: \(evens)");
