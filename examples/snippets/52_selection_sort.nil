fn selectionSort(arr) {
    let n = len(arr);
    let i = 0;
    while (i < n - 1) {
        let minIdx = i;
        let j = i + 1;
        while (j < n) {
            if (arr[j] < arr[minIdx]) {
                minIdx = j;
            }
            j = j + 1;
        }
        let temp = arr[minIdx];
        arr[minIdx] = arr[i];
        arr[i] = temp;
        i = i + 1;
    }
    return arr;
}
let list = [29, 10, 14, 37, 13];
puts("সিলেকশন সর্ট: \(selectionSort(list))");