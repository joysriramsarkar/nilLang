fn isPalindrome(str) {
    let n = len(str);
    let i = 0;
    while (i < n / 2) {
        if (str[i] != str[n - 1 - i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

let rMadam = isPalindrome("madam");
let rNilang = isPalindrome("nilang");
puts("madam কি প্যালিনড্রোম? \(rMadam)");
puts("nilang কি প্যালিনড্রোম? \(rNilang)");
