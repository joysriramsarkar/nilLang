fn isPrime(n) {
    if (n <= 1) {
        return false;
    }
    if (n <= 3) {
        return true;
    }
    if (n % 2 == 0 || n % 3 == 0) {
        return false;
    }
    let i = 5;
    while (i * i <= n) {
        if (n % i == 0 || n % (i + 2) == 0) {
            return false;
        }
        i = i + 6;
    }
    return true;
}

puts("17 মৌলিক? \(isPrime(17))");
puts("25 মৌলিক? \(isPrime(25))");
puts("97 মৌলিক? \(isPrime(97))");
