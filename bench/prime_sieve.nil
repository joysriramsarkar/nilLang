fn isPrime(n) {
    if (n < 2) {
        return false;
    }
    let d = 2;
    while (d * d <= n) {
        if ((n / d) * d == n) {
            return false;
        }
        d = d + 1;
    }
    return true;
}

fn countPrimes(limit) {
    let count = 0;
    let i = 2;
    while (i <= limit) {
        if (isPrime(i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

let total = countPrimes(50);
total;
