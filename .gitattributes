# Language detection and syntax classification
*.nil linguist-language=Nilang
*.nil linguist-detectable=true
*.nil linguist-documentation=false
examples/**/*.nil linguist-detectable=true
examples/**/*.nil linguist-documentation=false

# Generated build artifacts and binaries
*.nabc linguist-generated=true
*.wasm linguist-generated=true
*.wat linguist-generated=true
*.apk linguist-generated=true
*.nilax linguist-generated=true
build/** linguist-generated=true
dist/** linguist-generated=true
bin/** linguist-generated=true

# Line ending normalization
* text=auto eol=lf
*.go text eol=lf
*.nil text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
