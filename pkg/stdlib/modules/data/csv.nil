// Nilang Standard Library
// Module: std/data/csv
//
// সরল CSV সহায়ক — parse/parseLine/encodeRow।
// উদ্ধৃত-ফিল্ডের পূর্ণ পার্সিং ভবিষ্যৎ হোস্ট-বাস্তবায়নের কাজ।

let parseLine = fn(line) {
    return split(line, ",");
};

let parse = fn(text) {
    let rawLines = split(text, "\n");
    let rows = [];
    let i = 0;

    while (i < len(rawLines)) {
        let line = trim(rawLines[i]);

        if (line != "") {
            rows = push(rows, parseLine(line));
        }

        i = i + 1;
    }

    return rows;
};

let encodeRow = fn(values) {
    let rendered = [];
    let i = 0;

    while (i < len(values)) {
        rendered = push(rendered, str(values[i]));
        i = i + 1;
    }

    return join(rendered, ",");
};
