let spawn = fn(work) {
    return task { return work(); };
};
let wait = fn(future) {
    return await future;
};
let spawnValue = fn(value) {
    return task { return value; };
};
let spawnWith = fn(work, arg) {
    return task { return work(arg); };
};
let waitAll = fn(futures) {
    let out = [];
    let i = 0;
    while (i < len(futures)) {
        let f = futures[i];
        out = push(out, await f);
        i = i + 1;
    }
    return out;
};
let mapAsync = fn(items, worker) {
    let futures = [];
    let i = 0;
    while (i < len(items)) {
        futures = push(futures, spawnWith(worker, items[i]));
        i = i + 1;
    }
    return waitAll(futures);
};
