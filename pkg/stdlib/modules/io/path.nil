let splitBoth = fn(p) {
    let fwd = split(p, "/");
    let out = [];
    let i = 0;
    while (i < len(fwd)) {
        let chunk = fwd[i];
        let back = split(chunk, "\\");
        let j = 0;
        while (j < len(back)) {
            out = push(out, back[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
};
let joinPath = fn(a, b) {
    if (a == "" || a == null) {
        return b;
    }
    if (b == "" || b == null) {
        return a;
    }
    let tail = substr(a, len(a) - 1);
    if (tail == "/" || tail == "\\") {
        return a + b;
    }
    return a + "/" + b;
};
let joinAll = fn(parts) {
    let out = "";
    let i = 0;
    while (i < len(parts)) {
        out = joinPath(out, parts[i]);
        i = i + 1;
    }
    return out;
};
let basename = fn(p) {
    let parts = splitBoth(p);
    if (len(parts) == 0) {
        return "";
    }
    return last(parts);
};
let dirname = fn(p) {
    let parts = splitBoth(p);
    if (len(parts) <= 1) {
        return "";
    }
    let kept = [];
    let i = 0;
    while (i < len(parts) - 1) {
        kept = push(kept, parts[i]);
        i = i + 1;
    }
    return join(kept, "/");
};
let extName = fn(p) {
    let base = basename(p);
    let parts = split(base, ".");
    if (len(parts) < 2) {
        return "";
    }
    return "." + last(parts);
};
let withoutExt = fn(p) {
    let dir = dirname(p);
    let base = basename(p);
    let parts = split(base, ".");
    if (len(parts) < 2) {
        return p;
    }
    let kept = [];
    let i = 0;
    while (i < len(parts) - 1) {
        kept = push(kept, parts[i]);
        i = i + 1;
    }
    let stem = join(kept, ".");
    if (dir == "") {
        return stem;
    }
    return dir + "/" + stem;
};
let isAbsolute = fn(p) {
    if (p == "" || p == null) {
        return false;
    }
    if (substr(p, 0, 1) == "/") {
        return true;
    }
    if (len(p) >= 2) {
        if (substr(p, 1, 1) == ":") {
            return true;
        }
    }
    return false;
};
