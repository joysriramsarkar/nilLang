// Nilang Standard Library
// Module: std/math

const PI = 3.141592653589793;
const E = 2.718281828459045;

let abs = fn(value) {
    if (value < 0) {
        return -value;
    }
    return value;
};

let min = fn(a, b) {
    if (a < b) {
        return a;
    }
    return b;
};

let max = fn(a, b) {
    if (a > b) {
        return a;
    }
    return b;
};

let clamp = fn(value, low, high) {
    if (value < low) {
        return low;
    }

    if (value > high) {
        return high;
    }

    return value;
};

let sign = fn(value) {
    if (value < 0) {
        return -1;
    }

    if (value > 0) {
        return 1;
    }

    return 0;
};

let isEven = fn(value) {
    return value % 2 == 0;
};

let isOdd = fn(value) {
    return value % 2 != 0;
};

let gcd = fn(a, b) {
    let x = abs(a);
    let y = abs(b);

    while (y != 0) {
        let remainder = x % y;
        x = y;
        y = remainder;
    }

    return x;
};

let lcm = fn(a, b) {
    if (a == 0 || b == 0) {
        return 0;
    }

    return abs((a / gcd(a, b)) * b);
};

let factorial = fn(n) {
    if (n < 0) {
        return null;
    }

    let result = 1;
    let i = 2;

    while (i <= n) {
        result = result * i;
        i = i + 1;
    }

    return result;
};

let powInt = fn(base, exponent) {
    if (exponent < 0) {
        return 1 / powInt(base, -exponent);
    }

    let result = 1;
    let n = exponent;

    while (n > 0) {
        if (n % 2 == 1) {
            result = result * base;
        }

        base = base * base;
        n = n / 2;
    }

    return result;
};

let fibonacci = fn(n) {
    if (n < 0) {
        return null;
    }

    if (n == 0) {
        return 0;
    }

    if (n == 1) {
        return 1;
    }

    let a = 0;
    let b = 1;
    let i = 2;

    while (i <= n) {
        let next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }

    return b;
};

let average = fn(values) {
    if (len(values) == 0) {
        return null;
    }

    let total = 0;
    let i = 0;

    while (i < len(values)) {
        total = total + values[i];
        i = i + 1;
    }

    return total / len(values);
};

import "std/math/decimal" as decimalModule;
import "std/money" as moneyModule;

let decimal = decimalModule.new;
let decimalAdd = decimalModule.add;
let decimalSub = decimalModule.sub;
let decimalMul = decimalModule.mul;
let decimalDiv = decimalModule.div;
let decimalToString = decimalModule.toString;

let money = moneyModule.new;
let moneyOfMinor = moneyModule.ofMinor;
let moneyOfMajor = moneyModule.ofMajor;
let moneyAdd = moneyModule.add;
let moneySub = moneyModule.sub;
let moneyMulQty = moneyModule.mulQty;
let moneyFormat = moneyModule.format;
