const SECOND = 1;
const MINUTE = 60;
const HOUR = 3600;
const DAY = 86400;
const WEEK = 604800;
let seconds = fn(value) {
    return value;
};
let minutes = fn(value) {
    return value * MINUTE;
};
let hours = fn(value) {
    return value * HOUR;
};
let days = fn(value) {
    return value * DAY;
};
let weeks = fn(value) {
    return value * WEEK;
};
let millis = fn(value) {
    return value / 1000;
};
let toMinutes = fn(d) {
    return d / MINUTE;
};
let toHours = fn(d) {
    return d / HOUR;
};
let toDays = fn(d) {
    return d / DAY;
};
let formatBn = fn(d) {
    if (d < 60) {
        return str(d) + " সেকেন্ড";
    }
    if (d < 3600) {
        return str(d / 60) + " মিনিট";
    }
    if (d < 86400) {
        return str(d / 3600) + " ঘণ্টা";
    }
    return str(d / 86400) + " দিন";
};
