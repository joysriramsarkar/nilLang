// Nilang Standard Library
// Module: std/strings

let empty = fn(value) {
    return len(value) == 0;
};

let nonEmpty = fn(value) {
    return len(value) != 0;
};

let equalsIgnoreCase = fn(a, b) {
    return lower(a) == lower(b);
};

let startsWith = fn(value, prefix) {
    return hasPrefix(value, prefix);
};

let endsWith = fn(value, suffix) {
    return hasSuffix(value, suffix);
};

let includes = fn(value, needle) {
    return contains(value, needle);
};

let capitalize = fn(value) {
    if (len(value) == 0) {
        return value;
    }

    let firstChar = substr(value, 0, 1);
    let restText = substr(value, 1);

    return upper(firstChar) + restText;
};

let normalized = fn(value) {
    return lower(trim(value));
};

let reverse = fn(value) {
    let result = "";
    let i = len(value) - 1;

    while (i >= 0) {
        result = result + substr(value, i, 1);
        i = i - 1;
    }

    return result;
};

let repeat = fn(value, count) {
    let result = "";

    let i = 0;
    while (i < count) {
        result = result + value;
        i = i + 1;
    }

    return result;
};

let lines = fn(value) {
    return split(value, "\n");
};

let words = fn(value) {
    let cleaned = trim(value);

    if (cleaned == "") {
        return [];
    }

    return split(cleaned, " ");
};

let joinLines = fn(values) {
    return join(values, "\n");
};

let joinStrings = fn(values, delim) {
    return join(values, delim);
};

let splitString = fn(value, delim) {
    return split(value, delim);
};

let trimString = fn(value) {
    return trim(value);
};

let toLower = fn(value) {
    return lower(value);
};

let toUpper = fn(value) {
    return upper(value);
};

let replaceAll = fn(value, oldVal, newVal) {
    return replace(value, oldVal, newVal);
};

let substring = fn(value, start, length) {
    return substr(value, start, length);
};

let length = fn(value) {
    return len(value);
};
