// Nilang Standard Library
// Module: std/process
//
// প্রসেস-ফ্যাসাড — বর্তমান `exec` বিল্ট-ইনের ওপর।
// `exec` প্রসেসের exit code দেয়।

let run = fn(command) {
    return exec(command);
};

let runWith = fn(command, args) {
    if (len(args) == 0) {
        return exec(command);
    }

    if (len(args) == 1) {
        return exec(command, args[0]);
    }

    if (len(args) == 2) {
        return exec(command, args[0], args[1]);
    }

    if (len(args) == 3) {
        return exec(command, args[0], args[1], args[2]);
    }

    if (len(args) == 4) {
        return exec(command, args[0], args[1], args[2], args[3]);
    }

    return null;
};

let exitCode = fn(code) {
    return code;
};
