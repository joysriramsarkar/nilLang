let utf8 = fn(value) {
    return value;
};
let text = fn(value) {
    return str(value);
};
let byteLength = fn(value) {
    return len(value);
};
let lines = fn(value) {
    return split(value, "\n");
};
let words = fn(value) {
    let raw = split(value, " ");
    let out = [];
    let i = 0;
    while (i < len(raw)) {
        if (raw[i] != "") {
            out = push(out, raw[i]);
        }
        i = i + 1;
    }
    return out;
};
let wordCount = fn(value) {
    return len(words(value));
};
let joinLines = fn(lines) {
    return join(lines, "\n");
};
